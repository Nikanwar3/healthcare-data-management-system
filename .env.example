# Copy this file to .env (or export these in your shell) and fill in real
# values. Never commit a real .env file -- it is listed in .gitignore.

# Required -----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_DB=healthcare_dms
POSTGRES_USER=your_username

# Optional -- omit entirely for local trust/peer authentication (no password)
POSTGRES_PASSWORD=

# Optional connection settings (defaults shown) ------------------------------
POSTGRES_PORT=5432
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5

# Optional -------------------------------------------------------------------
LOG_LEVEL=INFO

# Used only by python/tests/integration (a separate, disposable database that
# the test suite creates and drops itself):
POSTGRES_TEST_DB=healthcare_dms_test
